# Maintainer: TunBridge <qwisixDEV@users.noreply.github.com>
pkgname=tunbridge
pkgver=1.0.2
pkgrel=1
pkgdesc="Нативный VPN/прокси-клиент на Qt 6: системный прокси и TUN-режим с управлением Zapret"
arch=('x86_64' 'aarch64')
url="https://github.com/qwisixDEV/TunBridge"
license=('MIT')
depends=('qt6-base' 'curl' 'openssl' 'zlib' 'iproute2' 'polkit' 'systemd')
makedepends=('cmake' 'ninja' 'gcc' 'pkgconf')
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$srcdir/TunBridge-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # Гарантируем исполняемый режим; привилегии helper получает через pkexec.
  for bin in tunbridge tunbridge-helper; do
    if [[ -f "$pkgdir/usr/bin/$bin" ]]; then
      chmod 0755 "$pkgdir/usr/bin/$bin"
    fi
  done

  install -Dm644 "$srcdir/TunBridge-$pkgver/packaging/linux/tunbridge.desktop" \
    "$pkgdir/usr/share/applications/tunbridge.desktop"
  install -Dm644 "$srcdir/TunBridge-$pkgver/packaging/linux/org.tunbridge.helper.policy" \
    "$pkgdir/usr/share/polkit-1/actions/org.tunbridge.helper.policy"
}
